      {
        "id": "pf1",
        "type": "system",
        "compatibility": {
          "minimum": "11.11",
          "verified": "11.11"
        }
      }
    ],
    "requires": [
      {
        "id": "lib-wrapper",
        "type": "module",
        "reason": "Required to intercept native PF1 use methods without non-libWrapper prototype modifications."
      }
    ]
  },
  "esmodules": [
    "scripts/reload-core.js"
  ],
  "languages": [
